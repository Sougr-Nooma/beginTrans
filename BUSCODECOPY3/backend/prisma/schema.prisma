generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Seed: npm run db:seed (admin@fasobus.bf / admin123)
model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  firstName     String?
  lastName      String?
  phone         String?
  role          String         @default("CLIENT")
  companySlug   String?        @unique
  companyName   String?
  address       String?
  description   String?
  logo          String?
  rating        Float          @default(4)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  trips         Trip[]
  specialOffers SpecialOffer[]
  jobOffers     JobOffer[]
}

model Trip {
  id             String   @id @default(cuid())
  companyUserId  String
  company        User     @relation(fields: [companyUserId], references: [id], onDelete: Cascade)
  companySlug    String
  departureCity  String
  arrivalCity    String
  departureTime  DateTime
  arrivalTime    DateTime
  price          Int
  availableSeats Int
  totalSeats     Int
  busType        String   @default("Standard")
  gares          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companySlug])
  @@index([departureCity, arrivalCity])
}

model SpecialOffer {
  id                 String   @id @default(cuid())
  companyUserId      String?
  company            User?    @relation(fields: [companyUserId], references: [id], onDelete: SetNull)
  companySlug        String?
  title              String
  description        String
  discountCode       String?
  discountPercentage Int?
  lineName           String?
  createdAt          DateTime @default(now())
}

model JobOffer {
  id            String   @id @default(cuid())
  companyUserId String?
  company       User?    @relation(fields: [companyUserId], references: [id], onDelete: SetNull)
  companySlug   String?
  title         String
  description   String
  location      String
  type          String
  createdAt     DateTime @default(now())
}
