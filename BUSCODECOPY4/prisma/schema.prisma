generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Client {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique
  phone     String
  password  String
  role      String   @default("CLIENT")
  createdAt DateTime @default(now())
}

model Company {
  id          String   @id
  name        String
  email       String   @unique
  phone       String
  address     String?
  description String?
  password    String
  createdAt   DateTime @default(now())
}
